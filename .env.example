# Copy to .env.local and fill in real values. Never commit .env.local — only
# this .example file (with placeholders) is tracked in git.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Postgres (ENGINEERING.md §1 / §5.3) ---
# Create the project in an EU region (Frankfurt/Ireland/Paris) for GDPR — not
# the default. Supabase dashboard: Project Settings > Database > Connect.
#
# DATABASE_URL: pooled connection (Supavisor, "Transaction" mode, port 6543).
# Used by the app at runtime — safe for serverless (many short-lived conns).
# URL-encode special characters in the password (": " -> %3A, "#" -> %23, etc).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL: session-mode connection (same pooler host, port 5432). Used for
# migrations — Drizzle's migration runner needs session-level features the
# transaction-mode pooler doesn't support. Deliberately NOT db.<ref>.supabase.co
# directly — that host is IPv6-only unless you buy Supabase's IPv4 add-on;
# the pooler's session mode gives the same guarantees over IPv4.
DIRECT_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Payload CMS ---
# Signs/encrypts sessions. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# --- Media storage: Supabase Storage, S3-compatible (ENGINEERING.md §6) ---
# Supabase dashboard: Project Settings > Storage > S3 Connection.
# Left blank, the app runs on dev without configured storage until Phase 1
# wires the adapter — never fabricate these.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<project-region, e.g. eu-central-1>
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Spam protection: Cloudflare Turnstile (ENGINEERING.md §7.2) ---
# Left blank, public forms (Contact, Hotels & Spas enquiry) fall back to
# honeypot + rate limiting only — see PENDING.md #10.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Google Calendar OAuth (ENGINEERING.md §6) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Left blank, the booking module uses a fake
# calendar adapter — see PENDING.md #5. These only identify the app; the
# calendar itself is connected by Nadia in the admin (Google Calendar page).
# Authorized redirect URI to register for each environment:
#   <NEXT_PUBLIC_SITE_URL>/api/globals/calendar-connection/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email — Resend (https://resend.com → API Keys). Leave empty
# to only log emails to the console. EMAIL_FROM must use a domain verified
# in Resend; for a first test, Resend's own "onboarding@resend.dev" works
# but only delivers to the address of the Resend account itself.
RESEND_API_KEY=
EMAIL_FROM="The Way Within <hello@thewaywithinwithnadia.com>"
