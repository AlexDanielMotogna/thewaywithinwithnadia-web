# Copy to .env.local and fill in real values. Never commit .env.local — only
# this .example file (with placeholders) is tracked in git.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Postgres (ENGINEERING.md §1 / §5.3) ---
# Create the project in an EU region (Frankfurt/Ireland/Paris) for GDPR — not
# the default. Supabase dashboard: Project Settings > Database > Connect.
#
# DATABASE_URL: pooled connection (Supavisor, "Transaction" mode, port 6543).
# Used by the app at runtime — safe for serverless (many short-lived conns).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DATABASE_URL_UNPOOLED: direct connection (port 5432). Used for migrations
# only — Drizzle's migration runner needs session-level features that the
# transaction-mode pooler doesn't support.
DATABASE_URL_UNPOOLED=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Payload CMS ---
# Signs/encrypts sessions. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# --- Media storage: Supabase Storage, S3-compatible (ENGINEERING.md §6) ---
# Supabase dashboard: Project Settings > Storage > S3 Connection.
# Left blank, the app runs on dev without configured storage until Phase 1
# wires the adapter — never fabricate these.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<project-region, e.g. eu-central-1>
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
